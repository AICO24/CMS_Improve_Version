DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cemetery_db
DB_USER=root
DB_PASSWORD=
PORT=5000

# Required for the primary AI provider (Gemini). Every AI feature falls
# back to its existing deterministic/unavailable behavior when this is
# empty — the service still runs and the recommend/forecast endpoints are
# entirely unaffected either way.
GEMINI_API_KEY=

# Optional. Selects the default provider chain used by every AI call site
# EXCEPT ai/assistant-ask (which always uses a fixed ["gemini", "backup"]
# chain — see llm_provider.py). Only "gemini" is a valid value; anything
# else (or leaving this unset) safely falls back to "gemini".
AI_PROVIDER=gemini

# Optional. Backup provider (Groq) used ONLY as the second link in
# ai/assistant-ask's fallback chain, and only when Gemini fails with an
# eligible infrastructure failure (not simply because Gemini declined to
# answer). Leaving this empty is safe — the backup step is skipped and
# ai/assistant-ask behaves exactly as it did before Batch 6.
GROQ_API_KEY=
