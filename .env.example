DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cemetery_db
DB_USER=root
DB_PASS=
JWT_SECRET=cemetery-super-secret-key-change-this
JWT_EXPIRY=3600

# Opt-in only. When true, logging in will auto-create admin/admin123 and
# staff/staff123 accounts if they don't exist yet. Leave false in production.
SEED_DEFAULT_USERS=false

# Comma-separated list of origins allowed to call the API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost
