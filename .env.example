DB_HOST=127.0.0.1
# Port 3306 is standard MySQL/XAMPP; use 3307 if running Laragon's bundled MariaDB. Must match python-ai/.env
DB_PORT=3306
DB_NAME=cemetery_db
DB_USER=root
DB_PASS=
JWT_SECRET=cemetery-super-secret-key-change-this
JWT_EXPIRY=28800
JWT_REMEMBER_EXPIRY=2592000

# local | production. Gates dev-only auth behavior (default-user seeding, and
# returning password-reset codes directly in API responses instead of
# emailing them) so it stays inert even if SEED_DEFAULT_USERS is left true or
# no mail service has been wired up yet. Set to production on any real
# deployment.
APP_ENV=local

# Opt-in only. When true (and APP_ENV is not production), logging in will
# auto-create admin/admin123 and staff/staff123 accounts if they don't exist
# yet. Leave false in production.
SEED_DEFAULT_USERS=false

# Comma-separated list of origins allowed to call the API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost

# Opt-in only. When true, ai/assistant-ask logs one line per request to
# PHP's error log (scope, module count, approximate context character
# count) — no facts, PII, or prompt text. Leave false in production.
AI_CONTEXT_DEBUG=false
# ----------------------------------------------------------------------
# PayMongo (future payment gateway - Batch 2 foundation only, no checkout yet)
# ----------------------------------------------------------------------
# All values are placeholders ONLY. NEVER commit real credentials here or
# anywhere else in the repo; copy real sandbox/live values into the
# gitignored .env at deploy time. With these unset, the CMS runs fully
# "configured but disabled": manual/offline payment keeps working and the
# PayMongoService reports unconfigured and fails closed.
#
# PAYMONGO_ENV=test            # test | live (never leave live on in dev)
# PAYMONGO_PUBLIC_KEY=         # pk_test_... - safe for the browser later; sent to the frontend only by a dedicated public-config endpoint, never hard-coded
# PAYMONGO_SECRET_KEY=         # sk_test_... - SERVER-ONLY. Never send to browser/HTML/JS.
# PAYMONGO_WEBHOOK_SECRET=     # whk_... - webhook signature secret (Batch 4+). SERVER-ONLY.
# PAYMONGO_API_BASE=           # optional override; default https://api.paymongo.com/v1
